; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shuyi Playland"
config/description="数一游园 - 面向小学数学学习的离线轻游戏化应用"
config/version="0.9.1-product"
run/main_scene="res://scenes/App.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Shuyi Playland"
config/features=PackedStringArray("4.6")

[autoload]

ContentService="*res://autoload/ContentService.gd"
AppState="*res://autoload/AppState.gd"
BackupService="*res://autoload/BackupService.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
